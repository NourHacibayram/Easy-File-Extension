{
  "manifest_version": 3,
  "name": "Clipboard & Downloads Upload Manager",
  "version": "1.1.2",
  "minimum_chrome_version": "109",
  "incognito": "not_allowed",
  "description": "Automatically presents recent clipboard images and downloaded files when uploading on any web page.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "clipboardRead",
    "activeTab",
    "offscreen",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["picker.html", "picker.css", "picker.js"],
      "matches": ["<all_urls>"],
      "use_dynamic_url": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clipboard & Downloads"
  }
}
